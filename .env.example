# ---------------------------------------------------------------------------
# CareerBoost AI — environment variables
# Copy to `.env` for local dev, and add the same keys in Vercel
# (Project Settings -> Environment Variables) for deployment.
# NEVER commit real secret values.
# ---------------------------------------------------------------------------

# --- Client (exposed to the browser, safe to publish) ----------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Server (never exposed to the browser) ---------------------------------
# Same values as above, read by SSR / server functions.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"

# Service-role key. REQUIRED only for admin features (role management,
# admin dashboard). Keep it server-side only — never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# Shared HMAC secret configured in both Hitavir Tech and CareerBoost. Hitavir
# signs completion events sent to POST /api/hitavir-completion with this value.
HITAVIR_WEBHOOK_SECRET=""

# AI provider key used by the resume analysis and cover-letter server
# functions (Lovable AI Gateway, OpenAI-compatible endpoint).
# REQUIRED for analysis + cover letter generation.
LOVABLE_API_KEY=""

# Optional preferred provider for AI Mentor. When present, the mentor uses the
# OpenAI Responses API. Without either AI key, it uses the built-in offline
# coaching engine so the page remains functional.
OPENAI_API_KEY=""
OPENAI_MENTOR_MODEL="gpt-5-mini"

# --- Application controls ---------------------------------------------------
APP_ENV="development"
RESUME_RETENTION_DAYS="30"
AI_RATE_LIMIT_PER_HOUR="30"
